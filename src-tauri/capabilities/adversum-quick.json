{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "adversum-quick",
  "description": "Least-privilege capability for the Adversum quick entry bar",
  "windows": [
    "adversum-quick"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit-to",
    "store:allow-load",
    "store:allow-get",
    "log:allow-log"
  ]
}
